rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /meetings/{meetingId} {
      // 공유 링크: 회의록 ID(추측 불가한 무작위 값)를 아는 사람은 그 회의록 하나만 볼 수 있음
      allow get: if true;
      // 목록 조회·작성·수정·삭제는 로그인한 운영진만
      allow list, write: if request.auth != null;
    }
  }
}
